# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다(.gitignore).
# 사용할 공급자: gemini | openai | claude (비우면 모델 이름으로 판단: gemini… · claude…)
DOCSREAD_LLM_PROVIDER=gemini
DOCSREAD_LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DOCSREAD_LLM_EFFORT=           # Claude 생각 깊이(low · medium · high) — Haiku 4.5 는 비워 둠
# DOCSREAD_LLM_TEMPERATURE=0     # 비우면 temperature 를 보내지 않음(추론 모델용)
# DOCSREAD_LLM_THINKING=         # Gemini 생각 수준: 숫자(토큰 한도) 또는 low 등
# DOCSREAD_LLM_MAX_TOKENS=32000  # 응답이 잘린다는 오류가 나면 늘린다
# DOCSREAD_LLM_DPI=200
